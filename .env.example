# Copy to .env and fill in what you need. .env is gitignored; never commit real keys.
# Without the two API keys the app runs in fixture mode only (synthetic sources, no cost).

# fixture | live
PREDIXION_MODE=fixture
PREDIXION_ENV=development
PREDIXION_HOST=127.0.0.1
PREDIXION_PORT=8000

# Provider keys (server side only; never exposed to the browser)
OPENAI_API_KEY=
TAVILY_API_KEY=

# Model and the prices used for cost estimates and the per-run cost ceiling.
# Re-check prices on the provider's pricing page before relying on the ceiling.
RESEARCH_MODEL=gpt-6.1-terra
RESEARCH_REASONING_EFFORT=low
MODEL_INPUT_USD_PER_MTOK=1.0
MODEL_OUTPUT_USD_PER_MTOK=5.0
TAVILY_USD_PER_CREDIT=0.008

# Optional Groq key. With it, the tasks in GROQ_TASKS try Groq's hosted OpenAI open-weight
# models first and fall back to OpenAI; every other task falls back to Groq when OpenAI fails.
# Requests larger than GROQ_MAX_REQUEST_TOKENS (input estimate + output cap) skip Groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_INPUT_USD_PER_MTOK=0.15
GROQ_OUTPUT_USD_PER_MTOK=0.60
# Blank disables the second Groq model.
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_INPUT_USD_PER_MTOK=0.075
GROQ_FALLBACK_OUTPUT_USD_PER_MTOK=0.30
# Any of: plan, extract, follow_up, synthesize, verify, repair, baseline. Blank keeps every task on OpenAI first.
GROQ_TASKS=plan,follow_up
GROQ_MAX_REQUEST_TOKENS=8000
# false: each task uses only its first model that fits, with normal retries.
MODEL_FALLBACK=true

# Per-run limits
MAX_ROUNDS=2
MAX_QUERIES_PER_ROUND=3
MAX_PAGES_PER_RUN=8
RUN_DEADLINE_S=120
MAX_TOKENS_PER_RUN=150000
MAX_COST_USD_PER_RUN=0.60

# Service limits
MAX_CONCURRENT_RUNS=4
MAX_QUEUED_RUNS=16
PREDIXION_DB_PATH=data/predixion.sqlite3
RUN_RETENTION_DAYS=7

# Auth: "none" is only allowed on loopback. For anything reachable by others use
# AUTH_MODE=token and put the line printed by `predixion token --user NAME` here.
AUTH_MODE=none
API_TOKEN_HASHES=
# With AUTH_MODE=token, what a visitor without a token may do: none | fixture | live.
# Each visitor's runs are kept apart by a random id the browser sends; it is not a credential.
PUBLIC_ACCESS=none
# Admission limits for new live runs (0 = off). The per-user limit is for fairness only
# (a visitor can clear its id) and resets on restart. The daily limit times
# MAX_COST_USD_PER_RUN is what bounds daily provider spend.
LIVE_RUNS_PER_USER_PER_HOUR=0
LIVE_RUNS_PER_DAY=0
# File that keeps live-run start times so LIVE_RUNS_PER_DAY survives restarts. Blank keeps
# them in memory. When the file cannot be written, live runs are refused.
LIVE_LEDGER_PATH=
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Strict-Transport-Security max-age in seconds, for HTTPS deployments only; 0 sends no header.
HSTS_MAX_AGE_S=0

# Serve the built frontend from the API process (npm run build in frontend/ first)
SERVE_FRONTEND_DIR=

# Testing only: lets the UI and API simulate provider failures. Ignored when PREDIXION_ENV=production.
ENABLE_FAULT_INJECTION=false
LOG_LEVEL=INFO
# Logs never include questions or page text unless this is true.
LOG_CONTENT=false
